# Supabase configuration — CITYPULSE runs on REAL data only (no demo mode).
# Copy to .env.local and fill in your project credentials.
#
# SECURITY:
#   - Use ONLY the publishable ("anon") key in frontend code.
#   - NEVER put SUPABASE_SERVICE_ROLE_KEY, DATABASE_PASSWORD, MQTT_PASSWORD
#     or FUSION_AI_SECRET in VITE_ variables.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY